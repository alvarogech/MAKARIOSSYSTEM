# Copie para .env.local e preencha com os valores impressos por
# `supabase start` (ambiente local) ou pelo painel do projeto Supabase
# (homologação/produção). Nunca versionar .env.local — ver .gitignore.

# --- Aplicação -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# URL e chave publicável: seguros para o navegador, respeitam RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta: EXCLUSIVAMENTE server-side. Nunca prefixar com
# NEXT_PUBLIC_. Usada apenas por src/integrations/supabase/admin.ts.
SUPABASE_SECRET_KEY=

# --- SMTP Titan (e-mails institucionais — camada própria, fora do escopo
# de execução da Fase 1, mas já reservado no schema de variáveis) ---------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=makarios@igrejaemaus.com.br
SMTP_PASSWORD=
SMTP_FROM_NAME=Escola Makários | Igreja Emaús
SMTP_FROM_EMAIL=makarios@igrejaemaus.com.br
SMTP_REPLY_TO=makarios@igrejaemaus.com.br

# --- Certificados (Fase 7 — reservado) -------------------------------------
CERTIFICATE_PUBLIC_BASE_URL=http://localhost:3000/certificados/validar
